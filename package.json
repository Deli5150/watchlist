{
  "name": "watchlist",
  "version": "1.0.0",
  "description": "WatchList \u2014 track the shows and movies you watch, for macOS, Windows and Android",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.25",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-sharing": "~58.0.23",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zustand": "^5.1.0",
    "expo-localization": "~58.0.5",
    "expo-document-picker": "~58.0.5"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "desktop": "node scripts/desktop.mjs && cd desktop && npx electron .",
    "dist:desktop": "node scripts/desktop.mjs --mac --win",
    "dist:android": "cd android && ./gradlew assembleRelease",
    "dist:ios": "sh scripts/ios.sh",
    "release": "node scripts/release.mjs",
    "icons": "desktop/node_modules/.bin/electron scripts/render-icons.cjs"
  },
  "private": true,
  "license": "MIT",
  "repository": "github:Deli5150/watchlist"
}
